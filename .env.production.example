# =====================================================================
# JornalPro — variables de entorno (PRODUCCIÓN)
# =====================================================================
# El `.env` de la RAÍZ es la única fuente de variables del proyecto.
# `docker-compose.production.yml`, `.prod.yml` y `.dokploy.yml` leen
# ese archivo y solo ese.
#
#   cp .env.production.example .env    # y completa los <REEMPLAZAR>
#
# En Dokploy, pega estas variables en el panel de Environment del
# proyecto; Dokploy escribe el `.env` por ti.
#
# NUNCA commitees el `.env` real (está en .gitignore).
# =====================================================================

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.production
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<REEMPLAZAR>
DJANGO_DEBUG=false
# Ruta del admin: cámbiala, no la dejes en /admin/
DJANGO_ADMIN_URL=<REEMPLAZAR>/
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.com
DJANGO_CORS_ALLOWED_ORIGINS=https://tudominio.com
CORS_ALLOW_CREDENTIALS=True
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_NAME_LOG_FILE=django_prod
DJANGO_SERVER_EMAIL=no-reply@tudominio.com

# ---- Sesión ----
JWT_REFRESH_TOKEN_DAYS=7
# En producción todo va por TLS: la cookie debe exigirlo.
JWT_COOKIE_SECURE=true

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jornal_pro_trabajadores
POSTGRES_USER=<REEMPLAZAR>
POSTGRES_PASSWORD=<REEMPLAZAR>
DATABASE_URL=postgres://<USER>:<PASSWORD>@pgbouncer:6432/jornal_pro_trabajadores

# ---- PgBouncer ----
PGB_POSTGRES_HOST=pgbouncer
PGB_POSTGRES_PORT=6432
PGB_POSTGRES_DB=${POSTGRES_DB}
PGB_POSTGRES_USER=${POSTGRES_USER}
PGB_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_FLOWER_USER=<REEMPLAZAR>
CELERY_FLOWER_PASSWORD=<REEMPLAZAR>
CANT_WORKERS_CELERY=2
WEB_CONCURRENCY=4

# ---- Frontend / Traefik ----
DOMAIN=tudominio.com
VITE_API_URL=https://tudominio.com

# ---- Límites de recursos (Dokploy / VPS) ----
DJANGO_CPU=1
DJANGO_RAM=1024M
FRONTEND_CPU=0.5
FRONTEND_RAM=256M
NGINX_CPU=0.5
NGINX_RAM=256M
PGBOUNCER_CPU=0.5
PGBOUNCER_RAM=256M
TRAEFIK_CPU=0.5
TRAEFIK_RAM=256M
CELERYWORKER_CPU=0.5
CELERYWORKER_RAM=512M
CELERYBEAT_CPU=0.25
CELERYBEAT_RAM=256M
