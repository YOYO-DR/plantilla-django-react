# =====================================================================
# JornalPro — variables de entorno (DESARROLLO LOCAL)
# =====================================================================
# Copia este archivo a `.env` en la raíz y completa los valores.
# En desarrollo real, los archivos `backend/.envs/.local/.django` y
# `backend/.envs/.local/.postgres` ya tienen valores seguros por
# defecto. Este `.env.example` documenta TODAS las variables del
# proyecto para que un dev nuevo sepa qué hay disponible.
#
# PRODUCCIÓN: ver `backend/.envs/.production/` y la sección
# "Despliegue en Dokploy" del README.
# =====================================================================

# --- General ----------------------------------------------------------
# Marca que estamos corriendo dentro de Docker (afecta debug-toolbar).
USE_DOCKER=yes
# Directorio donde IPython guarda su historial (dentro del contenedor).
IPYTHONDIR=/app/.ipython
# Clave secreta de Django. CAMBIAR en producción. 50+ caracteres.
DJANGO_SECRET_KEY=local-development-secret-key-not-for-production
# Orígenes de confianza para CSRF (separados por coma).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Orígenes CORS (frontends permitidos).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Cookies HttpOnly + SameSite=Lax con credenciales.
CORS_ALLOW_CREDENTIALS=True
# Nombre del archivo de log (sin extensión). Sale en `backend/logs/`.
DJANGO_NAME_LOG_FILE=django_dev
# DEBUG=true solo para desarrollo. NUNCA true en producción.
DJANGO_DEBUG=true

# --- Database ---------------------------------------------------------
# URL completa de Postgres (formato django-environ).
DATABASE_URL=postgres://debug:debug@postgres:5432/jornal_pro_trabajadores

# --- Redis ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Celery -----------------------------------------------------------
# Broker usa REDIS_URL automáticamente; no requiere var extra.
# Flower (panel de Celery) — usuario y password del panel web.
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# --- JWT --------------------------------------------------------------
# Días de validez del refresh token. 7 es razonable para SaaS.
JWT_REFRESH_TOKEN_DAYS=7
# `true` en producción (HTTPS). `false` en local (HTTP).
JWT_COOKIE_SECURE=false

# --- Frontend ---------------------------------------------------------
# (Variables consumidas por Vite durante `pnpm build` en el contenedor
# del frontend; ver `frontend/.env`.)
# VITE_API_URL=http://localhost:8000/api
