# =====================================================================
# JornalPro — variables de entorno (DESARROLLO LOCAL)
# =====================================================================
# El `.env` de la RAÍZ es la única fuente de variables del proyecto.
# Todos los docker-compose (local, docs, prod, production, dokploy)
# leen ese archivo y solo ese.
#
#   cp .env.example .env      # y completa los <REEMPLAZAR>
#
# El `.env` real está en .gitignore: nunca se commitea.
# Para desplegar, ver `.env.production.example`.
# =====================================================================

# ---- Django ----
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<REEMPLAZAR>
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_CREDENTIALS=True
DJANGO_NAME_LOG_FILE=django_dev
DJANGO_DEBUG=true

# ---- Servicios ----
DATABASE_URL=postgres://debug:debug@postgres:5432/jornal_pro_trabajadores
REDIS_URL=redis://redis:6379/0
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=<REEMPLAZAR>

# ---- Sesión ----
JWT_REFRESH_TOKEN_DAYS=7
# En local va por http, así que la cookie no puede exigir TLS.
JWT_COOKIE_SECURE=false

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jornal_pro_trabajadores
POSTGRES_USER=debug
POSTGRES_PASSWORD=<REEMPLAZAR>

# ---- PgBouncer (reusa las credenciales de Postgres) ----
PGB_POSTGRES_HOST=pgbouncer
PGB_POSTGRES_PORT=6432
PGB_POSTGRES_DB=${POSTGRES_DB}
PGB_POSTGRES_USER=${POSTGRES_USER}
PGB_POSTGRES_PASSWORD=<REEMPLAZAR>

# ---- Frontend (Vite, se lee al construir) ----
VITE_API_URL=http://localhost:8000
